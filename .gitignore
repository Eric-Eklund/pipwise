# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
.import/
export.cfg
# export_presets.cfg is tracked on purpose: it is the Android build config, and
# an untracked one means every machine has to rebuild it from memory. It holds
# no secrets — keystore paths and passwords live in the editor's own settings,
# not in this file.

# Imported translations (automatically generated from CSV files)
*.translation.godot/
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Export folders
exports/
Exports/

# IDE and OS specific
.vscode/
.idea/
.DS_Store

# Plugin specific
addons/script-ide/*