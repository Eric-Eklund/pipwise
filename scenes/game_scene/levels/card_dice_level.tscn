[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/game_scene/levels/card_dice_level.gd" id="1_level"]
[ext_resource type="PackedScene" path="res://scenes/game_scene/hud/score_hud.tscn" id="2_scorehud"]
[ext_resource type="Script" path="res://scenes/game_scene/dice/dice_tray.gd" id="3_dicetray"]
[ext_resource type="PackedScene" path="res://scenes/game_scene/dice/die_view.tscn" id="4_dieview"]
[ext_resource type="Script" path="res://scenes/game_scene/cards/hand_view.gd" id="5_handview"]
[ext_resource type="PackedScene" path="res://scenes/game_scene/cards/card_view.tscn" id="6_cardview"]
[ext_resource type="PackedScene" path="res://scenes/game_scene/hud/energy_hud.tscn" id="7_energyhud"]
[ext_resource type="Theme" path="res://resources/themes/lab.tres" id="8_theme"]
[ext_resource type="PackedScene" path="res://scenes/windows/hand_guide_window.tscn" id="9_guide"]

[node name="CardDiceLevel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("8_theme")
script = ExtResource("1_level")
hand_guide_scene = ExtResource("9_guide")

[node name="Background" type="ColorRect" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.09, 0.12, 0.16, 1)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 20

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ScoreHud" parent="MarginContainer/VBoxContainer" instance=ExtResource("2_scorehud")]
unique_name_in_owner = true
layout_mode = 2

[node name="TopSpacer" type="Control" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3

[node name="HandView" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 6
alignment = 1
script = ExtResource("5_handview")
card_view_scene = ExtResource("6_cardview")

[node name="HandNameLabel" type="Label" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "High Card  x1"
horizontal_alignment = 1

[node name="CardHintLabel" type="Label" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.58, 0.64, 1)
theme_override_font_sizes/font_size = 13
text = "Tap cards to mark them, then Swap  ·  3⚡ each"
horizontal_alignment = 1
autowrap_mode = 2

[node name="MiddleSpacer" type="Control" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 0.5

[node name="DiceHintLabel" type="Label" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.58, 0.64, 1)
theme_override_font_sizes/font_size = 13
text = "Dice pips are your energy — and they add to your score"
horizontal_alignment = 1
autowrap_mode = 2

[node name="EnergyHud" parent="MarginContainer/VBoxContainer" instance=ExtResource("7_energyhud")]
unique_name_in_owner = true
layout_mode = 2

[node name="DiceTray" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 8
alignment = 1
script = ExtResource("3_dicetray")
die_view_scene = ExtResource("4_dieview")

[node name="DiceLockHintLabel" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.58, 0.64, 1)
theme_override_font_sizes/font_size = 13
text = "Tap a die to keep it through a reroll"
horizontal_alignment = 1
autowrap_mode = 2

[node name="BottomSpacer" type="Control" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 0.28

[node name="ActionBar" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SwapButton" type="Button" parent="MarginContainer/VBoxContainer/ActionBar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
size_flags_horizontal = 3
disabled = true
text = "Swap cards"

[node name="RerollButton" type="Button" parent="MarginContainer/VBoxContainer/ActionBar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
size_flags_horizontal = 3
text = "Reroll  3 left"

[node name="SaveButton" type="Button" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
text = "Save hand"

[connection signal="pressed" from="MarginContainer/VBoxContainer/ActionBar/SwapButton" to="." method="_on_swap_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/ActionBar/RerollButton" to="." method="_on_reroll_button_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/SaveButton" to="." method="_on_save_button_pressed"]
